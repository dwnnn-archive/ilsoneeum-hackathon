  "narrative": {
    "northStar": "청도의 들판으로 이어지는 일자리",
    "overview": "따뜻한 오렌지, 둥근 흰색 표면, 청도 들판을 떠올리는 단순한 풍경이 사용자가 제공한 시각 기준이다. 작업 조건은 먼저 읽히고, AI는 선택 기능이며, 모든 공고와 로컬 활동은 시연용임을 분명히 한다.",
    "keyCharacteristics": [
      "따뜻한 오렌지 주요 행동",
      "둥근 흰색 공고 카드",
      "청도 들판을 추상화한 CSS 풍경",
      "모바일 하단 작업 내비게이션",
      "탐색·등록 흐름에 붙는 선택형 AI 도구"
    ],
    "rules": [
      {
        "name": "Conditions Before Claims",
        "body": "작업, 날짜, 시간, 위치, 급여, 인원을 확인할 수 있게 한다. 샘플을 실제 채용이나 입증된 성과로 표현하지 않는다.",
        "section": "responsible-presentation"
      }
    ],
    "dos": [
      "Do label illustrative listings and local-only actions.",
      "Do keep AI suggestions editable and explicitly reviewable.",
      "Do use orange for actions and semantic colors for state."
    ],
    "donts": [
      "Don't claim verified work, placements, or measurable impact.",
      "Don't send application contact fields to AI providers.",
      "Don't let AI supply missing schedule or pay as facts."
    ]
  }
